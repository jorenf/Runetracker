# ============================================================
# Discord Bot Configuration
# ============================================================

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID from the Discord developer portal
DISCORD_CLIENT_ID=your_discord_client_id_here

# ============================================================
# WiseOldMan API (optional – only needed if you hit rate limits)
# Free API key at https://wiseoldman.net/
# ============================================================
WOM_API_KEY=

# ============================================================
# Tracker Settings
# ============================================================

# How often (in milliseconds) to poll the WiseOldMan API for updates.
# Default: 300000 (5 minutes). Minimum recommended: 60000 (1 minute).
TRACKER_INTERVAL_MS=300000

# Delay (ms) between WOM API requests to avoid rate limiting.
# Default: 1500
WOM_REQUEST_DELAY_MS=1500

# ============================================================
# Database
# ============================================================

# Path to the SQLite database file (relative to project root).
DB_PATH=./data/muskebeers.db

# ============================================================
# Logging
# ============================================================

# Log level: error | warn | info | debug
LOG_LEVEL=info
