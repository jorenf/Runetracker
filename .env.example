# ============================================================
# Discord Bot Configuration
# ============================================================

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID from the Discord developer portal
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional guild ID for fast slash-command deployment during development.
# Leave empty to register commands globally.
GUILD_ID=

# ============================================================
# WiseOldMan API
# ============================================================

# Optional API key for higher rate limits. Get one at https://wiseoldman.net/
WOM_API_KEY=

# Max WOM API requests per minute (default 40; WOM's cap is 60).
# Lower this if you share your VPS IP with other WOM consumers.
WOM_REQUESTS_PER_MINUTE=40

# ============================================================
# Tracker Settings
# ============================================================

# How often (in milliseconds) to poll WiseOldMan for player updates.
# Default: 300000 (5 minutes). Minimum recommended: 60000 (1 minute).
TRACKER_INTERVAL_MS=300000

# ============================================================
# Storage
# ============================================================

# Root directory for all bot data files (guild configs + snapshots).
# Default: ./data  (relative to project root)
DATA_DIR=./data

# ============================================================
# Logging
# ============================================================

# Log level: error | warn | info | debug
LOG_LEVEL=info

# ============================================================
# HTTP Server
# ============================================================

# Port for /health, /webhook/loot, optional admin endpoints, and /api/site.
# Railway custom domain api.runetracker.icu is configured for port 8080.
PORT=8080

# Optional. When set, enables /admin/* endpoints via ?key=ADMIN_SECRET.
# Use a long random value and never commit production secrets.
ADMIN_SECRET=

# ============================================================
# Public Site API
# ============================================================

# Optional. Serves the external site folder from the bot HTTP server.
# Example for the sibling site folder used during development: ../site
SITE_DIR=

# Optional. When set, /api/site* requires X-Site-Key or ?key=SITE_API_KEY.
# Leave empty only when the sanitized public stats API may be public.
SITE_API_KEY=

# CORS origin for /api/site* when the site is hosted separately.
SITE_CORS_ORIGIN=https://runetracker.icu,https://www.runetracker.icu

# Cache duration for /api/site/weekly-xp Wise Old Man lookups.
SITE_WEEKLY_CACHE_MS=900000
