# ============================================================
# Discord Bot Configuration
# ============================================================

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID from the Discord developer portal
DISCORD_CLIENT_ID=your_discord_client_id_here

# ============================================================
# WiseOldMan API
# ============================================================

# Optional API key for higher rate limits – free at https://wiseoldman.net/
WOM_API_KEY=

# Max WOM API requests per minute (default 40; WOM's cap is 60).
# Lower this if you share your VPS IP with other WOM consumers.
WOM_REQUESTS_PER_MINUTE=40

# ============================================================
# Tracker Settings
# ============================================================

# How often (in milliseconds) to poll WiseOldMan for player updates.
# Default: 300000 (5 minutes). Minimum recommended: 60000 (1 minute).
TRACKER_INTERVAL_MS=300000

# ============================================================
# Storage
# ============================================================

# Root directory for all bot data files (guild configs + snapshots).
# Default: ./data  (relative to project root)
DATA_DIR=./data

# ============================================================
# Logging
# ============================================================

# Log level: error | warn | info | debug
LOG_LEVEL=info
